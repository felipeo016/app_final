# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# El backend lee estas variables del entorno y, si existe, también el .env de la raíz del repo.

# --- General ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8090
CORS_ORIGINS=http://localhost:5173

# --- MongoDB ---
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/unicanal

# --- JWT ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRATION_MINUTES=480

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Tenant al que se asignan los mensajes del webhook (id de la empresa)
WHATSAPP_DEFAULT_TENANT_ID=
# Opcional: otra versión o un servidor de pruebas de la Graph API
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0

# --- Tiempo real (WebSocket en /ws) ---
# Orígenes del frontend que pueden abrir el WebSocket, separados por coma
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# --- Tareas periódicas (alerta de chats en riesgo, cierre de WebSocket vencidos) ---
# Déjalo en true; solo las pruebas automáticas las desactivan.
SCHEDULING_ENABLED=true

# --- Frontend (Vite) ---
VITE_BACKEND_URL=http://localhost:8090
